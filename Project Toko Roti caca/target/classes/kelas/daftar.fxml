<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane stylesheets="@styles/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.DaftarController">
    <top>
        <VBox spacing="12" styleClass="header">
         <Label styleClass="title" text="Daftar Produk Toko" />
            <Label styleClass="title" text="RotibyChacha">
            <font>
               <Font size="3.0" />
            </font></Label>
            <HBox spacing="10">
                <TextField fx:id="cariField" onAction="#cari" promptText="Cari nama produk..." HBox.hgrow="ALWAYS" />
                <Button onAction="#cari" text="Cari" />
                <Button onAction="#tambah" styleClass="button-primary" text="Tambah Produk" />
                <Button onAction="#detail" text="Lihat Detail" />
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tabel">
            <columns>
                <TableColumn fx:id="kodeCol" prefWidth="120" text="Kode" />
                <TableColumn fx:id="namaCol" prefWidth="280" text="Nama Produk" />
                <TableColumn fx:id="kategoriCol" prefWidth="150" text="Kategori" />
                <TableColumn fx:id="hargaCol" prefWidth="180" text="Harga (Rp)" />
            </columns>
        </TableView>
    </center>
    <bottom>
        <Label fx:id="pesanLabel" styleClass="error" wrapText="true" />
    </bottom>
</BorderPane>
